# Zone 后端环境变量示例：只列变量名与说明，不要在此填写真实值。
# 生产环境（NODE_ENV=production）缺失下列任一密钥时服务拒绝启动。
# 本地开发可在 shell 中 export，或用 `node --env-file=.env` 加载；.env 已被 git 忽略。

# 运行环境：production 时启用必需变量校验
NODE_ENV=

# MongoDB root 用户密码
MONGO_PASSWORD=
# Redis 访问密码
REDIS_PASSWORD=
# 阿里云 OSS AccessKey ID（用于签发前端直传 policy）
OSS_ACCESS_KEY_ID=
# 阿里云 OSS AccessKey Secret
OSS_ACCESS_KEY_SECRET=
# QQ 邮箱 SMTP 授权码（发件人地址见 src/constant/settings.ts）
SMTP_PASSWORD=
# 登录 token 的 JWT 签名密钥，建议 32 字节以上随机串
JWT_SECRET=
# AI 网关 API Key
AI_API_KEY=
